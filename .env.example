# ==============================================================================
# OUR FOREVER WORLD - PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE SERVER & DEPLOYMENT (RENDER)
# ------------------------------------------------------------------------------
# Port for the Node/Express server (Render automatically sets this to 10000)
PORT=

# Runtime environment (always "production" on Render)
NODE_ENV=production

# Allowed CORS Origins (set to "*" or your Render/custom domain)
ALLOWED_ORIGINS=*

# Frontend API URL (LEAVE BLANK when deploying frontend and backend together on Render)
VITE_API_URL=

# Public URL of the server (e.g. https://our-forever-world.onrender.com)
SERVER_PUBLIC_URL=https://our-forever-world.onrender.com

# Runtime environment (always "production" on Render)


