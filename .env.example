# ==========================================
# OUR FOREVER WORLD - PRODUCTION ENVIRONMENT
# ==========================================

# Server Environment
PORT=3001
NODE_ENV=production

# Frontend API URL (Leave blank if hosted unified on Render/Railway, or set to your Render backend URL if frontend is on Vercel)
# Example: https://our-forever-world-api.onrender.com
VITE_API_URL=

# CORS Allowed Origins (Comma-separated for multiple origins, or * for all)
ALLOWED_ORIGINS=*

# Public URL of Server (For serving media files locally if cloud storage is not used)
# Example: https://our-forever-world.onrender.com
SERVER_PUBLIC_URL=

# ==========================================
# 1. PERSISTENT CLOUD DATABASE (Recommended: Supabase or Upstash Redis)
# ==========================================
# Supabase PostgreSQL (Free tier: https://supabase.com)
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# OR Upstash Serverless Redis (Free tier: https://upstash.com)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ==========================================
# 2. PERSISTENT CLOUD MEDIA STORAGE (Recommended: Cloudinary)
# ==========================================
# Cloudinary (Free tier: https://cloudinary.com - 25GB free storage for high-res photos and audio)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional unsigned preset if using client-side uploads:
CLOUDINARY_UPLOAD_PRESET=
