<?xml version="1.0" encoding="UTF-8"?>
<svg xmlns="http://www.w3.org/2000/svg" width="800" height="1000" viewBox="0 0 800 1000">
  <defs>
    <linearGradient id="grad1" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#ff758c" />
      <stop offset="100%" stop-color="#ff7eb3" />
    </linearGradient>
    <radialGradient id="glow" cx="50%" cy="40%" r="50%">
      <stop offset="0%" stop-color="#ffffff" stop-opacity="0.4" />
      <stop offset="100%" stop-color="#ffffff" stop-opacity="0" />
    </radialGradient>
    <filter id="shadow" x="-10%" y="-10%" width="120%" height="120%">
      <feDropShadow dx="0" dy="15" stdDeviation="20" flood-color="#000" flood-opacity="0.25"/>
    </filter>
  </defs>

  <!-- Background Canvas -->
  <rect width="800" height="1000" fill="url(#grad1)" />
  <circle cx="400" cy="400" r="350" fill="url(#glow)" />

  <!-- Elegant Inner Border -->
  <rect x="40" y="40" width="720" height="920" rx="20" fill="none" stroke="#ffffff" stroke-width="3" stroke-opacity="0.6" stroke-dasharray="12 6" />
  <rect x="55" y="55" width="690" height="890" rx="16" fill="none" stroke="#ffffff" stroke-width="1.5" stroke-opacity="0.4" />

  <!-- Decorative Corner Accents -->
  <path d="M70,120 L70,70 L120,70" fill="none" stroke="#ffffff" stroke-width="4" stroke-linecap="round" />
  <path d="M730,120 L730,70 L680,70" fill="none" stroke="#ffffff" stroke-width="4" stroke-linecap="round" />
  <path d="M70,880 L70,930 L120,930" fill="none" stroke="#ffffff" stroke-width="4" stroke-linecap="round" />
  <path d="M730,880 L730,930 L680,930" fill="none" stroke="#ffffff" stroke-width="4" stroke-linecap="round" />

  <!-- Floating Heart Illustration -->
  <g transform="translate(400, 380) scale(1.6)" filter="url(#shadow)">
    <path d="M 0,-40 C -40,-90 -120,-40 -120,30 C -120,90 0,160 0,180 C 0,160 120,90 120,30 C 120,-40 40,-90 0,-40 Z" fill="#ffffff" fill-opacity="0.95" />
    <circle cx="-35" cy="0" r="12" fill="#ff758c" fill-opacity="0.3" />
    <circle cx="35" cy="15" r="8" fill="#ff7eb3" fill-opacity="0.4" />
  </g>

  <!-- Photo Badge -->
  <rect x="300" y="110" width="200" height="42" rx="21" fill="#ffffff" fill-opacity="0.25" />
  <text x="400" y="137" font-family="'Georgia', serif" font-size="18" font-weight="bold" fill="#ffffff" text-anchor="middle" letter-spacing="4">MEMORY 01</text>

  <!-- Title & Subtitle -->
  <text x="400" y="660" font-family="'Georgia', serif" font-size="34" font-weight="bold" fill="#ffffff" text-anchor="middle" filter="url(#shadow)">The Day Our Stars Aligned</text>
  <text x="400" y="710" font-family="'Helvetica Neue', sans-serif" font-size="20" fill="#ffffff" fill-opacity="0.9" text-anchor="middle" letter-spacing="2">Where Our Journey Began</text>

  <!-- Instruction hint -->
  <rect x="220" y="770" width="360" height="50" rx="25" fill="#ffffff" fill-opacity="0.9" filter="url(#shadow)" />
  <text x="400" y="802" font-family="'Helvetica Neue', sans-serif" font-size="16" font-weight="600" fill="#ff4d6d" text-anchor="middle">Replace with your photograph: memory1.jpg</text>

  <!-- Sparkle stars -->
  <polygon points="180,240 185,255 200,260 185,265 180,280 175,265 160,260 175,255" fill="#ffffff" fill-opacity="0.8" />
  <polygon points="620,300 624,312 636,316 624,320 620,332 616,320 604,316 616,312" fill="#ffffff" fill-opacity="0.8" />
  <polygon points="220,540 223,550 233,553 223,556 220,566 217,556 207,553 217,550" fill="#ffffff" fill-opacity="0.8" />
</svg>